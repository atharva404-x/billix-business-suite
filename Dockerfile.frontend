# ==============================================================================
# Billix Frontend Production Dockerfile
# Multi-stage build compiling React/Vite assets and serving via Node.js Alpine
# ==============================================================================

# --- Stage 1: Build ---
FROM node:22-alpine AS build

WORKDIR /app

# Copy package manifests and lock files
COPY package.json package-lock.json bun.lock* ./

# Install dependencies
RUN npm ci --include=dev

# Copy source code and build config
COPY . .

# Build production bundle using the node-server preset for Nitro
ENV NODE_ENV=production
ENV NITRO_PRESET=node-server
RUN npm run build


# --- Stage 2: Runtime ---
FROM node:22-alpine AS runtime

LABEL maintainer="Billix Engineering <devops@billix.app>"
LABEL description="Billix SaaS Billing Platform React Frontend"

WORKDIR /app

# Copy compiled Nitro server and public static assets from build stage
COPY --from=build /app/.output /app/.output

# Set environment defaults
ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

# Healthcheck targeting the Nitro server on port 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Start the Nitro server
CMD ["node", ".output/server/index.mjs"]
